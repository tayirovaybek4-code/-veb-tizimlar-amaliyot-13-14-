{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talaba",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "fio", "guruh", "fan", "baho", "holat", "davomat", "qaydVaqti"],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "maximum": 8640000000000000, "description": "Yozuvning asosiy kaliti." },
    "fio": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "guruh": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "\\S" },
    "fan": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "baho": { "type": "integer", "minimum": 0, "maximum": 100 },
    "holat": { "enum": ["Faol", "Nofaol"] },
    "davomat": { "enum": ["Qayd etilmagan", "Qatnashdi", "Qatnashmadi", "Sababli"] },
    "qaydVaqti": { "type": "string", "format": "date-time", "description": "Yozuv yaratilgan vaqt, UTC." }
  },
  "examples": [
    {
      "id": 101,
      "fio": "Sinovchi Ali",
      "guruh": "24-ATT-01",
      "fan": "Veb tizimlar",
      "baho": 88,
      "holat": "Faol",
      "davomat": "Qatnashdi",
      "qaydVaqti": "2026-09-24T16:00:00Z"
    }
  ]
}
